PORT=4000
MONGODB_URI=mongodb://localhost:27017/ai-engineering-manager
REDIS_URL=redis://localhost:6379
NODE_ENV=development
TZ=Asia/Kolkata

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SOCKET_MODE=true
# Optional: limit sync to channel IDs (comma-separated). Empty = all channels the bot is in.
# SLACK_SYNC_CHANNELS=
# SLACK_SYNC_LIMIT=50

# Optional LLM enhancement (falls back to rule-based parser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Reminder interval in milliseconds (default 1 hour)
REMINDER_INTERVAL_MS=3600000

# CORS
CORS_ORIGIN=http://localhost:4200

# JWT (optional dashboard auth)
JWT_SECRET=change-me-in-production
