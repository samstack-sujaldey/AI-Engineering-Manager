PORT=4000
MONGODB_URI=mongodb://localhost:27017/ai-engineering-manager
REDIS_URL=redis://localhost:6379
NODE_ENV=development
TZ=Asia/Kolkata

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SOCKET_MODE=true
# Optional: limit sync to channel IDs (comma-separated). Empty = all channels the bot is in.
# SLACK_SYNC_CHANNELS=
# SLACK_SYNC_LIMIT=50

# Optional LLM enhancement (falls back to rule-based parser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Reminder interval in milliseconds (default 1 hour)
REMINDER_INTERVAL_MS=3600000

# CORS
CORS_ORIGIN=http://localhost:4200

# JWT (optional dashboard auth)
JWT_SECRET=change-me-in-production

# Used in: src/ai/openai.js
# How to get: Go to aistudio.google.com, then click 'API keys' in the left sidebar to create and copy a new API key.
GEMINI_API_KEY=your_gemini_api_key_placeholder

# Used in: src/services/slackSync.js
# How to get: This value specifies the maximum number of items to fetch or process during a Slack synchronization operation. It's a numerical setting configured within your application.
SLACK_SYNC_LIMIT=100

# Used in: src/services/slackSync.js
# How to get: A comma-separated list of Slack channel names or IDs your application should monitor or interact with. Configure this based on the specific channels relevant to your project.
SLACK_SYNC_CHANNELS=general,dev-logs,announcements

